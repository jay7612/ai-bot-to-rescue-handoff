# =================================================================
# Copy this file to .env and fill in your real values.
# Never commit your filled-in .env file.
# =================================================================

# --- OpenAI -------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.4-mini

# --- Nexthink -----------------------------------------------------
NEXTHINK_TENANT_URL=https://<your-tenant>.api.<region>.nexthink.cloud
NEXTHINK_BASIC_AUTH=Basic <your-base64-encoded-client_id:client_secret>
NEXTHINK_NQL_DEVICE_LOOKUP_ID=#<YOUR_NQL_API_QUERY>
NEXTHINK_REMOTE_ACTION_ID=#<YOUR_REMOTE_ACTION_NAME>

# --- ngrok (POC only) ---------------------------------------------
LISTENING_DOMAIN=your-domain.dev
